# MetaTrader 5 Configuration
# Obtenha o número da conta e servidor no menu
# Arquivo → Conectar à Conta de Corretora do MT5
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# ⚠️  MT5_TERMINAL_PATH: OBRIGATÓRIO para isolamento
#     (previne usar FBS/XP/outro broker)
#     Exemplo CLEAR:
#       C:\Program Files\Clear Investimentos MT5 Terminal\terminal64.exe
#     GARANTIDO: O agente apenas conectará ao terminal especificado
MT5_TERMINAL_PATH=C:\Program Files\Clear Investimentos MT5 Terminal\terminal64.exe

# ── Agente RL — Treinamento com Dados Reais ─────────────────
# Usado por scripts/treinar_novo_agente_rl.py --dados-reais
# Consulte docs/SETUP_PRODUCAO.md para instruções completas
# Símbolo do Mini Índice (padrão: WIN$N)
RL_SIMBOLO=WIN$N
# Quantidade de candles históricos a carregar (padrão: 5000)
RL_N_CANDLES=5000
# Saldo mínimo em R$ para validação de conta (padrão: 5000.0)
RL_SALDO_MINIMO=5000.0

# Trading Configuration
TRADING_SYMBOL=WIN$N
MAX_POSITIONS=2
RISK_PER_TRADE=0.02
MAX_DRAWDOWN=0.15
MIN_RISK_REWARD=2.0

# Database
DB_PATH=data/db/trading.db

# Logging
LOG_LEVEL=INFO
LOG_PATH=data/logs/

# Machine Learning
MODEL_PATH=data/models/
RETRAIN_INTERVAL=7

# Application
ENV=development
DEBUG=False

# ── APIs do Agente WDO/WINFUT ──────────────────────────────────
# FRED (macro data) — gratis com chave em https://fred.stlouisfed.org/docs/api/
FRED_API_KEY=

# TwelveData (market data) — gratis em https://twelvedata.com/
TWELVEDATA_API_KEY=

# AlphaVantage (indicadores economicos) — gratis em https://www.alphavantage.co/
ALPHAVANTAGE_API_KEY=

# Finnhub (calendario economico) — gratis em https://finnhub.io/
FINNHUB_API_KEY=

# Telegram Bot (alertas de score) — crie em https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ── Email Configuration (Gmail SMTP) ────────────────────────
# Gmail SMTP para envio de alertas automáticos
# 1. Ative 2FA no Google Account
# 2. Gere App Password: https://myaccount.google.com/apppasswords
# 3. Cole a senha de 16 caracteres em PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
FROM_EMAIL=seu_email@gmail.com
PASSWORD=seu_app_password_16_caracteres
ALERT_EMAIL=seu_email@gmail.com
EMAIL_NAME=Operador Quantico
EMAIL_TIMEOUT=10
EMAIL_MAX_RETRIES=3